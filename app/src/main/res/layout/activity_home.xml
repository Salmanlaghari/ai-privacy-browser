<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_premium_gradient">

    <!-- News Ticker Row -->
    <com.aibrowser.app.ui.home.NewsTickerView
        android:id="@+id/newsTicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_ticker"
        android:textColor="#FFFFFF"
        android:padding="10dp"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Premium Greeting Card with 3D effect -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="12dp"
                app:cardBackgroundColor="#1A1A2E">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/bg_3d_card">
                    <TextView
                        android:id="@+id/greetingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Good evening, User"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:fontFamily="sans-serif-medium" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔒 Protected by AI Privacy Shield"
                        android:textSize="12sp"
                        android:textColor="#B0B0FF"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Premium Search Bar with Glass Effect -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="25dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#2A2A4A">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="6dp">
                    <EditText
                        android:id="@+id/urlEditText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="🔍 Search or enter URL"
                        android:inputType="textUri|textAutoCorrect"
                        android:maxLines="1"
                        android:imeOptions="actionGo"
                        android:background="@android:color/transparent"
                        android:padding="14dp"
                        android:textSize="15sp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#8080AA" />
                    <ImageButton
                        android:id="@+id/btnHomeAiSearch"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_mic"
                        android:contentDescription="Ask AI Search"
                        android:background="@drawable/bg_mic_button"
                        android:padding="10dp" />
                    <Button
                        android:id="@+id/btnGo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Go"
                        android:background="@drawable/bg_go_button"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:layout_marginEnd="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Premium AI Assistants Section with 3D Cards -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤖 AI Assistants"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <!-- Ask AI 3D Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="10dp">
                    <Button
                        android:id="@+id/btnHomeAskAi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🤖 Ask AI"
                        android:background="@drawable/bg_3d_button_purple"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:padding="16dp"
                        android:textSize="14sp" />
                </androidx.cardview.widget.CardView>

                <!-- Summarize 3D Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="10dp">
                    <Button
                        android:id="@+id/btnHomeSummarize"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✨ Summarize"
                        android:background="@drawable/bg_3d_button_blue"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:padding="16dp"
                        android:textSize="14sp" />
                </androidx.cardview.widget.CardView>

                <!-- Translate 3D Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="10dp">
                    <Button
                        android:id="@+id/btnHomeTranslate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🌍 Translate"
                        android:background="@drawable/bg_3d_button_green"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:padding="16dp"
                        android:textSize="14sp" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Premium Privacy Shield Card with 3D Effect -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="18dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_privacy_card">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛡️"
                        android:textSize="28sp"
                        android:layout_marginEnd="14dp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/privacyBadgeText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Privacy Shield Active"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="48 trackers blocked today"
                            android:textColor="#B0FFB0"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRO"
                        android:textColor="#FFD700"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:background="@drawable/bg_pro_badge"
                        android:padding="6dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Category Filter horizontal scroll chips -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌐 Explore Categories"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="12dp">
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/categoryChipGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipNews"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📰 News"
                        android:checked="true"
                        app:chipBackgroundColor="@color/chip_selected_bg"
                        android:textColor="@color/chip_text_color" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSports"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏏 Sports"
                        app:chipBackgroundColor="@color/chip_selected_bg"
                        android:textColor="@color/chip_text_color" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTech"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💻 Tech"
                        app:chipBackgroundColor="@color/chip_selected_bg"
                        android:textColor="@color/chip_text_color" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipReligious"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🕌 Religious"
                        app:chipBackgroundColor="@color/chip_selected_bg"
                        android:textColor="@color/chip_text_color" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipShopping"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛒 Shopping"
                        app:chipBackgroundColor="@color/chip_selected_bg"
                        android:textColor="@color/chip_text_color" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipEntertainment"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎬 Entertainment"
                        app:chipBackgroundColor="@color/chip_selected_bg"
                        android:textColor="@color/chip_text_color" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Curated category items list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/categoryRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="24dp" />

            <!-- Personalized top 8 visited items -->
            <TextView
                android:id="@+id/personalizedTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Frequently Visited"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/personalizedRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Premium Bottom Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_premium_bottom_nav"
        android:elevation="12dp"
        android:padding="4dp">
        <Button
            android:id="@+id/btnHomeBookmarks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⭐ Bookmarks"
            android:background="@drawable/bg_nav_button"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
        <Button
            android:id="@+id/btnHomeHistory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📜 History"
            android:background="@drawable/bg_nav_button"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
        <Button
            android:id="@+id/btnHomeSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚙️ Settings"
            android:background="@drawable/bg_nav_button"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Bottom AdMob Banner Container -->
    <LinearLayout
        android:id="@+id/adBannerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#1A1A2E"
        android:visibility="gone" />

</LinearLayout>
