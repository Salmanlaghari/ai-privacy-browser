<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_premium_gradient"
    app:behavior_peekHeight="500dp">

    <!-- Handle indicator for bottom sheet -->
    <View
        android:layout_width="50dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_handle_indicator"
        android:layout_marginBottom="20dp" />

    <!-- Premium Header with 3D effect -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤖"
            android:textSize="28sp"
            android:layout_marginEnd="12dp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Search Assistant"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Powered by Gemini AI"
                android:textSize="12sp"
                android:textColor="#B0B0FF" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRO"
            android:textColor="#FFD700"
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="@drawable/bg_pro_badge"
            android:padding="6dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </LinearLayout>

    <!-- Premium Query Input Area -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_search_bar_premium"
            android:padding="6dp">
            <EditText
                android:id="@+id/aiSearchEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="✨ Ask anything..."
                android:background="@android:color/transparent"
                android:padding="14dp"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8080AA"
                android:maxLines="3"
                android:inputType="textMultiLine" />
            <Button
                android:id="@+id/btnSubmitAiSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Go"
                android:background="@drawable/bg_go_button"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginEnd="4dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Premium Quick Chips row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="16dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp">
                <Button
                    android:id="@+id/chipWeather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌤️ Weather"
                    android:background="@drawable/bg_chip_premium"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:padding="12dp" />
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp">
                <Button
                    android:id="@+id/chipExplain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧠 Explain Simple"
                    android:background="@drawable/bg_chip_premium"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:padding="12dp" />
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp">
                <Button
                    android:id="@+id/chipFact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯 Fun Fact"
                    android:background="@drawable/bg_chip_premium"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:padding="12dp" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Premium Response Area -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_response_area"
            android:padding="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <ProgressBar
                    android:id="@+id/loadingProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:indeterminateTint="#6C63FF" />
                <TextView
                    android:id="@+id/aiResponseTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✨ Response will be displayed here..."
                    android:textColor="#E0E0FF"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.cardview.widget.CardView>

    <!-- Premium Utility Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">
        <Button
            android:id="@+id/btnCopyResponse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋 Copy"
            android:background="@drawable/bg_utility_button"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginEnd="8dp" />
        <Button
            android:id="@+id/btnShareResponse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔗 Share"
            android:background="@drawable/bg_utility_button"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
